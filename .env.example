# Local core connection only. Never place RustFS/customer secrets in this file.
# Copy to an ignored, permission-restricted .env or supply these variables securely.
S3_AGENT_FULCRUM_API_URL=http://127.0.0.1:18000
S3_AGENT_FULCRUM_API_TOKEN=
S3_AGENT_JOB_POLL_INTERVAL=5s
S3_AGENT_METRIC_REPORT_INTERVAL=30s
S3_AGENT_HEALTH_INTERVAL=15s
S3_AGENT_LOG_LEVEL=INFO
S3_AGENT_LOG_FORMAT=json
